{
  "name": "soridam-design-system",
  "description": "A design system for Soridam project",
  "private": false,
  "version": "0.1.37",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles": "./dist/index.css"
  },
  "scripts": {
    "dev:app": "next dev",
    "build:app": "next build",
    "start:app": "next start",
    "build:ts": "tsup",
    "build:css": "npx tailwindcss -i ./src/globals.css -o ./dist/index.css --content './src/**/*.{ts,tsx}' --minify",
    "build": "npm run build:ts && npm run build:css",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "peerDependencies": {
    "framer-motion": "^12.23.12"
  },
  "dependencies": {
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.2.3",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^4.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "chromatic": "^13.1.3",
    "cross-spawn": "^7.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
